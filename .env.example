# Chile Explorer — Variables de entorno (Ejemplo)
# Copia este archivo como .env y completa los valores reales.
# El archivo .env real NUNCA debe subirse a Git.

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-segura-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos — SQLite (desarrollo local, valor por defecto)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Base de datos — MySQL/MariaDB (EC2 + phpMyAdmin)
# Descomenta y completa para usar MySQL en el servidor:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=chile_explorer
# DB_USER=chile_explorer_user
# DB_PASSWORD=tu_password_seguro
# DB_HOST=127.0.0.1
# DB_PORT=3306
